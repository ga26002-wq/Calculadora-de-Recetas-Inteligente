@model CalculadoraRecetasInteligente.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>ChefIA - Iniciar Sesión</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            body {
                min-height: 100vh;
                margin: 0;
                font-family: Arial, sans-serif;
                background: linear-gradient(135deg, #fff3e0, #ffe0b2);
            }

            .login-container {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
            }

            .login-card {
                width: 100%;
                max-width: 950px;
                min-height: 550px;
                background: white;
                border-radius: 25px;
                overflow: hidden;
                box-shadow: 0 15px 40px rgba(0,0,0,0.15);
            }

            .login-left {
                background: linear-gradient(135deg, #ff7a00, #ff9d2e);
                color: white;
                padding: 60px;
                display: flex;
                flex-direction: column;
                justify-content: center;
                height: 100%;
            }

                .login-left h1 {
                    font-weight: bold;
                    font-size: 3rem;
                }

            .chef-icon {
                font-size: 80px;
                margin-bottom: 20px;
            }

            .login-right {
                padding: 60px;
            }

            .form-control {
                padding: 13px;
                border-radius: 12px;
            }

            .btn-login {
                width: 100%;
                padding: 13px;
                border-radius: 12px;
                background-color: #ff7a00;
                border: none;
                font-weight: bold;
                color: white;
                transition: 0.3s;
            }

                .btn-login:hover {
                    background-color: #e66d00;
                    color: white;
                }

            .input-group-text {
                border-radius: 12px 0 0 12px;
            }

            @@media (max-width: 768px) {
                .login-left {
                    padding: 35px;
                }

                .login-right {
                    padding: 35px;
                }

                .login-left h1 {
                    font-size: 2.2rem;
                }
            }
    </style>
</head>

<body>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success text-center m-3">
            @TempData["MensajeExito"]
        </div>
    }

    <div class="login-container">

        <div class="login-card">

            <div class="row g-0">

                <!-- LADO IZQUIERDO -->
                <div class="col-md-6">

                    <div class="login-left">

                        <div class="chef-icon">
                            <i class="bi bi-robot"></i>
                        </div>

                        <h1>ChefIA</h1>

                        <h4 class="mt-3">
                            Tus recetas, ahora más inteligentes.
                        </h4>

                        <p class="mt-3">
                            Guarda tus recetas favoritas y utiliza inteligencia
                            artificial para ajustar cantidades, ingredientes y
                            preparaciones según tus necesidades.
                        </p>

                    </div>

                </div>

                <!-- LADO DERECHO -->
                <div class="col-md-6">

                    <div class="login-right">

                        <h2 class="fw-bold">¡Bienvenido!</h2>

                        <p class="text-muted mb-4">
                            Inicia sesión para continuar.
                        </p>

                        <!-- Mensaje de error general -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- FORMULARIO REAL -->
                        <form asp-action="Login" method="post">

                            @Html.AntiForgeryToken()

                            <div class="mb-3">

                                <label asp-for="Correo"
                                       class="form-label">
                                    Correo electrónico
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-envelope"></i>
                                    </span>

                                    <input asp-for="Correo"
                                           class="form-control"
                                           placeholder="ejemplo@correo.com" />

                                </div>

                                <span asp-validation-for="Correo"
                                      class="text-danger"></span>

                            </div>

                            <div class="mb-4">

                                <label asp-for="Contrasena"
                                       class="form-label">
                                    Contraseña
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-lock"></i>
                                    </span>

                                    <input asp-for="Contrasena"
                                           class="form-control"
                                           placeholder="Ingrese su contraseña" />

                                </div>

                                <span asp-validation-for="Contrasena"
                                      class="text-danger"></span>

                            </div>

                            <button type="submit"
                                    class="btn btn-login">

                                <i class="bi bi-box-arrow-in-right"></i>
                                Iniciar Sesión

                            </button>

                        </form>

                        <div class="text-center mt-4">

                            <span class="text-muted">
                                ¿No tienes una cuenta?
                            </span>

                            <a asp-controller="Auth"
                               asp-action="Registro"
                               class="text-decoration-none fw-bold">
                                Registrarse
                            </a>

                        </div>
                        
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Scripts para validaciones -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.20.0/dist/jquery.validate.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>