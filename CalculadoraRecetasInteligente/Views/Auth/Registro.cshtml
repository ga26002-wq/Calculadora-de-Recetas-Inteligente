@model CalculadoraRecetasInteligente.ViewModels.RegistroViewModel

@{
    ViewData["Title"] = "Crear Cuenta";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>ChefIA - Crear Cuenta</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            body {
                min-height: 100vh;
                margin: 0;
                font-family: Arial, sans-serif;
                background: linear-gradient(135deg, #fff3e0, #ffe0b2);
            }

            .registro-container {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 25px;
            }

            .registro-card {
                width: 100%;
                max-width: 1000px;
                background: white;
                border-radius: 25px;
                overflow: hidden;
                box-shadow: 0 15px 40px rgba(0,0,0,0.15);
            }

            .registro-left {
                background: linear-gradient(135deg, #ff7a00, #ff9d2e);
                color: white;
                padding: 60px;
                min-height: 600px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

                .registro-left h1 {
                    font-size: 3rem;
                    font-weight: bold;
                }

            .chef-icon {
                font-size: 80px;
                margin-bottom: 20px;
            }

            .registro-right {
                padding: 45px 55px;
            }

            .form-control {
                padding: 12px;
                border-radius: 12px;
            }

            .input-group-text {
                border-radius: 12px 0 0 12px;
            }

            .btn-registro {
                width: 100%;
                padding: 13px;
                border-radius: 12px;
                background-color: #ff7a00;
                border: none;
                color: white;
                font-weight: bold;
                transition: 0.3s;
            }

                .btn-registro:hover {
                    background-color: #e66d00;
                    color: white;
                }

            @@media (max-width: 768px) {
                .registro-left {
                    min-height: auto;
                    padding: 35px;
                }

                .registro-right {
                    padding: 35px;
                }

                .registro-left h1 {
                    font-size: 2.3rem;
                }
            }
    </style>
</head>

<body>

    <div class="registro-container">

        <div class="registro-card">

            <div class="row g-0">

                <!-- LADO IZQUIERDO -->
                <div class="col-md-6">

                    <div class="registro-left">

                        <div class="chef-icon">
                            <i class="bi bi-person-plus-fill"></i>
                        </div>

                        <h1>Únete a ChefIA</h1>

                        <h4 class="mt-3">
                            Crea tu cuenta y disfruta de recetas inteligentes.
                        </h4>

                        <p class="mt-3">
                            Guarda tus recetas favoritas, organiza tus ingredientes
                            y ajusta las cantidades según tus necesidades.
                        </p>

                    </div>

                </div>

                <!-- LADO DERECHO -->
                <div class="col-md-6">

                    <div class="registro-right">

                        <h2 class="fw-bold">Crear cuenta</h2>

                        <p class="text-muted mb-4">
                            Completa tus datos para comenzar.
                        </p>

                        <form asp-action="Registro" method="post">

                            <div class="mb-3">

                                <label asp-for="Nombre" class="form-label"></label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-person"></i>
                                    </span>

                                    <input asp-for="Nombre"
                                           class="form-control"
                                           placeholder="Ingrese su nombre" />

                                </div>

                                <span asp-validation-for="Nombre"
                                      class="text-danger"></span>

                            </div>


                            <div class="mb-3">

                                <label asp-for="Correo" class="form-label">
                                    Correo electrónico
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-envelope"></i>
                                    </span>

                                    <input asp-for="Correo"
                                           class="form-control"
                                           placeholder="ejemplo@correo.com" />

                                </div>

                                <span asp-validation-for="Correo"
                                      class="text-danger"></span>

                            </div>


                            <div class="mb-3">

                                <label asp-for="Contrasena"
                                       class="form-label">
                                    Contraseña
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-lock"></i>
                                    </span>

                                    <input asp-for="Contrasena"
                                           class="form-control"
                                           placeholder="Mínimo 6 caracteres" />

                                </div>

                                <span asp-validation-for="Contrasena"
                                      class="text-danger"></span>

                            </div>


                            <div class="mb-4">

                                <label asp-for="ConfirmarContrasena"
                                       class="form-label">
                                    Confirmar contraseña
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-shield-lock"></i>
                                    </span>

                                    <input asp-for="ConfirmarContrasena"
                                           class="form-control"
                                           placeholder="Repita su contraseña" />

                                </div>

                                <span asp-validation-for="ConfirmarContrasena"
                                      class="text-danger"></span>

                            </div>


                            <button type="submit"
                                    class="btn btn-registro">

                                <i class="bi bi-person-check-fill"></i>
                                Crear mi cuenta

                            </button>

                        </form>


                        <div class="text-center mt-4">

                            <span class="text-muted">
                                ¿Ya tienes una cuenta?
                            </span>

                            <a asp-controller="Auth"
                               asp-action="Login"
                               class="text-decoration-none fw-bold">

                                Iniciar sesión

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</body>
</html>