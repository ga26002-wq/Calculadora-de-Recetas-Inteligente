@model CalculadoraRecetasInteligente.ViewModels.CrearIngredienteViewModel

@{
    ViewData["Title"] = "Agregar Ingrediente";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>ChefIA - Agregar Ingrediente</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, sans-serif;
            background-color: #f5f6fa;
        }

        .sidebar {
            width: 260px;
            min-height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: linear-gradient(180deg, #ff7a00, #e65c00);
            color: white;
            padding: 25px 20px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 45px;
        }

        .logo-icon {
            font-size: 38px;
        }

        .logo h2 {
            margin: 0;
            font-weight: bold;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 14px 15px;
            margin-bottom: 8px;
            border-radius: 12px;
            color: white;
            text-decoration: none;
        }

        .menu-item:hover {
            background-color: rgba(255,255,255,0.20);
            color: white;
        }

        .menu-item.active {
            background-color: white;
            color: #ff7a00;
            font-weight: bold;
        }

        .main-content {
            margin-left: 260px;
            padding: 35px;
        }

        .topbar {
            background: white;
            border-radius: 18px;
            padding: 20px 25px;
            margin-bottom: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
        }

        .form-card {
            background: white;
            border-radius: 18px;
            padding: 35px;
            max-width: 750px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
        }

        .form-label {
            font-weight: bold;
            color: #2f3b4c;
        }

        .form-control {
            border-radius: 10px;
            padding: 12px;
        }

        .btn-save {
            background-color: #ff7a00;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 12px 22px;
            font-weight: bold;
        }

        .btn-save:hover {
            background-color: #e65c00;
            color: white;
        }

        .btn-cancel {
            border-radius: 10px;
            padding: 12px 22px;
        }

    </style>

</head>

<body>

    <!-- SIDEBAR -->

    <div class="sidebar">

        <div class="logo">

            <div class="logo-icon">
                <i class="bi bi-robot"></i>
            </div>

            <h2>ChefIA</h2>

        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="menu-item">

            <i class="bi bi-house-door-fill"></i>
            Dashboard

        </a>

        <a asp-controller="Home"
           asp-action="MisRecetas"
           class="menu-item">

            <i class="bi bi-journal-text"></i>
            Mis Recetas

        </a>

        <a asp-controller="Home"
           asp-action="Ingredientes"
           class="menu-item active">

            <i class="bi bi-basket"></i>
            Ingredientes

        </a>

        <a asp-controller="Home"
           asp-action="AjusteInteligente"
           class="menu-item">

            <i class="bi bi-stars"></i>
            Ajuste Inteligente

        </a>

        <a asp-controller="Home"
           asp-action="MiPerfil"
           class="menu-item">

            <i class="bi bi-person"></i>
            Mi Perfil

        </a>

        <a href="#"
           class="menu-item"
           data-bs-toggle="modal"
           data-bs-target="#modalCerrarSesion">

            <i class="bi bi-box-arrow-right"></i>
            Cerrar sesión

        </a>

    </div>


    <!-- CONTENIDO -->

    <div class="main-content">

        <div class="topbar">

            <h4 class="mb-1">
                Agregar ingrediente
            </h4>

            <small class="text-muted">
                Registra un nuevo ingrediente en tu lista
            </small>

        </div>


        <div class="form-card">

            <form asp-action="CrearIngrediente"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- NOMBRE -->

                <div class="mb-3">

                    <label asp-for="Nombre"
                           class="form-label">

                        Nombre del ingrediente

                    </label>

                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Ejemplo: Harina" />

                    <span asp-validation-for="Nombre"
                          class="text-danger"></span>

                </div>


                <!-- CANTIDAD -->

                <div class="mb-3">

                    <label asp-for="Cantidad"
                           class="form-label">

                        Cantidad

                    </label>

                    <input asp-for="Cantidad"
                           type="number"
                           step="0.01"
                           class="form-control"
                           placeholder="Ejemplo: 2" />

                    <span asp-validation-for="Cantidad"
                          class="text-danger"></span>

                </div>


                <!-- UNIDAD -->

                <div class="mb-4">

                    <label asp-for="UnidadMedida"
                           class="form-label">

                        Unidad de medida

                    </label>

                    <input asp-for="UnidadMedida"
                           class="form-control"
                           placeholder="Ejemplo: kg, gramos, litros, unidades" />

                    <span asp-validation-for="UnidadMedida"
                          class="text-danger"></span>

                </div>


                <!-- BOTONES -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-save">

                        <i class="bi bi-check-circle"></i>
                        Guardar ingrediente

                    </button>


                    <a asp-action="Ingredientes"
                       class="btn btn-secondary btn-cancel">

                        Cancelar

                    </a>

                </div>

            </form>

        </div>

    </div>

    <!-- MODAL CERRAR SESIÓN -->

    <div class="modal fade" id="modalCerrarSesion" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:20px; border:none;">

                <div class="modal-body text-center p-4">

                    <div style="font-size:45px; color:#ff7a00;">
                        <i class="bi bi-box-arrow-right"></i>
                    </div>

                    <h4 class="fw-bold mt-3">
                        ¿Quieres cerrar sesión?
                    </h4>

                    <p class="text-muted">
                        Se cerrará tu sesión actual.
                    </p>

                    <div class="d-flex justify-content-center gap-3 mt-4">

                        <button type="button"
                                class="btn btn-secondary px-4"
                                data-bs-dismiss="modal">
                            No
                        </button>

                        <a asp-controller="Auth"
                           asp-action="CerrarSesion"
                           class="btn px-4"
                           style="background:#ff7a00; color:white;">
                            Sí
                        </a>

                    </div>

                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>