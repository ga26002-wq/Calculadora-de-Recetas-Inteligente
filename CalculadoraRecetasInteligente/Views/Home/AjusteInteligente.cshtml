@using CalculadoraRecetasInteligente.Models

@{
    ViewData["Title"] = "Ajuste Inteligente";
    Layout = null;

    var recetas = ViewBag.Recetas as List<Receta>;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>ChefIA - Ajuste Inteligente</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            body {
                margin: 0;
                min-height: 100vh;
                font-family: Arial, sans-serif;
                background: #f4f6fb;
            }


            /* =========================
                       SIDEBAR
                    ========================== */

            .sidebar {
                width: 260px;
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: linear-gradient(180deg, #ff7a00, #e65c00);
                color: white;
                padding: 25px 20px;
                display: flex;
                flex-direction: column;
                overflow-y: auto;
                box-sizing: border-box;
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 45px;
            }

            .logo-icon {
                font-size: 38px;
            }

            .logo h2 {
                margin: 0;
                font-weight: bold;
            }


            /* MENU */

            .menu-item {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 14px 15px;
                margin-bottom: 8px;
                border-radius: 12px;
                color: white;
                text-decoration: none;
                transition: 0.3s;
            }

                .menu-item:hover {
                    background-color: rgba(255,255,255,0.20);
                    color: white;
                }

                .menu-item.active {
                    background-color: white;
                    color: #ff7a00;
                    font-weight: bold;
                }


            /* CERRAR SESIÓN ABAJO */

            .logout {
                margin-top: auto;
                padding-top: 20px;
            }


            /* =========================
                       CONTENIDO
                    ========================== */

            .main-content {
                margin-left: 260px;
                padding: 35px;
                max-width: 1500px;
            }


            /* =========================
                       ENCABEZADO
                    ========================== */

            .topbar {
                background: white;
                border-radius: 22px;
                padding: 28px 32px;
                margin-bottom: 30px;
                box-shadow: 0 8px 30px rgba(0,0,0,0.06);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .topbar-title {
                display: flex;
                align-items: center;
                gap: 15px;
            }

            .topbar-icon {
                width: 55px;
                height: 55px;
                border-radius: 16px;
                background: #fff0e6;
                color: #ff7a00;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 26px;
            }

            .topbar h2 {
                margin: 0;
                color: #2f3b4c;
                font-weight: bold;
            }


            /* =========================
                       GRID PRINCIPAL
                    ========================== */

            .ai-layout {
                display: grid;
                grid-template-columns: 1.3fr 0.7fr;
                gap: 25px;
                align-items: start;
            }


            /* =========================
                       TARJETA PRINCIPAL
                    ========================== */

            .adjust-card {
                background: white;
                border-radius: 24px;
                padding: 38px;
                box-shadow: 0 8px 30px rgba(0,0,0,0.06);
            }

            .ai-header {
                display: flex;
                align-items: center;
                gap: 20px;
                margin-bottom: 35px;
            }

            .ai-icon {
                width: 80px;
                height: 80px;
                min-width: 80px;
                border-radius: 22px;
                background: linear-gradient(135deg, #fff0e6, #ffe0c2);
                color: #ff7a00;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 38px;
            }

            .ai-header h3 {
                margin: 0 0 7px 0;
                color: #2f3b4c;
                font-weight: bold;
            }

            .ai-header p {
                margin: 0;
                color: #7a8492;
            }


            /* =========================
                       PASOS
                    ========================== */

            .step-label {
                display: flex;
                align-items: center;
                gap: 10px;
                font-weight: bold;
                color: #2f3b4c;
                margin-bottom: 10px;
            }

            .step-number {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: #ff7a00;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
            }

            .form-select,
            .form-control {
                border-radius: 14px;
                padding: 15px;
                border: 1px solid #dfe3ea;
                font-size: 16px;
            }

                .form-select:focus,
                .form-control:focus {
                    border-color: #ff7a00;
                    box-shadow: 0 0 0 0.2rem rgba(255,122,0,0.15);
                }


            /* =========================
                       BOTÓN
                    ========================== */

            .btn-adjust {
                width: 100%;
                background: linear-gradient(135deg, #ff8a00, #ff6500);
                color: white;
                border: none;
                border-radius: 14px;
                padding: 16px;
                font-size: 17px;
                font-weight: bold;
                transition: 0.3s;
            }

                .btn-adjust:hover {
                    transform: translateY(-2px);
                    color: white;
                    box-shadow: 0 10px 20px rgba(255,122,0,0.25);
                }


            /* =========================
                       PANEL IA
                    ========================== */

            .ai-panel {
                background: linear-gradient(180deg, #2f3b4c, #202a38);
                border-radius: 24px;
                padding: 32px;
                color: white;
                box-shadow: 0 8px 30px rgba(0,0,0,0.12);
            }

            .ai-panel-icon {
                width: 60px;
                height: 60px;
                border-radius: 18px;
                background: rgba(255,122,0,0.20);
                color: #ff9d3d;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 28px;
                margin-bottom: 20px;
            }

            .ai-panel h4 {
                font-weight: bold;
                margin-bottom: 15px;
            }

            .ai-panel p {
                color: #d4d9df;
                line-height: 1.7;
            }

            .ai-feature {
                display: flex;
                gap: 12px;
                margin-top: 20px;
                align-items: flex-start;
            }

                .ai-feature i {
                    color: #ff9d3d;
                    font-size: 20px;
                }

                .ai-feature strong {
                    display: block;
                }

                .ai-feature span {
                    color: #c5ccd5;
                    font-size: 14px;
                }


            /* =========================
                       CAJA INFO
                    ========================== */

            .info-box {
                margin-top: 28px;
                padding: 20px;
                border-radius: 16px;
                background: #fff8f1;
                border: 1px solid #ffe0c2;
                display: flex;
                gap: 15px;
                align-items: flex-start;
            }

                .info-box i {
                    color: #ff7a00;
                    font-size: 25px;
                }

                .info-box strong {
                    color: #2f3b4c;
                }

                .info-box p {
                    margin: 5px 0 0;
                    color: #697586;
                }


            /* =========================
                       RESPONSIVE
                    ========================== */

            @@media (max-width: 992px) {

                .ai-layout {
                    grid-template-columns: 1fr;
                }
            }


            @@media (max-width: 768px) {

                .sidebar {
                    position: relative;
                    width: 100%;
                    height: auto;
                    min-height: auto;
                }

                .logout {
                    margin-top: 20px;
                }

                .main-content {
                    margin-left: 0;
                    padding: 20px;
                }

                .topbar {
                    padding: 22px;
                }

                .adjust-card {
                    padding: 25px;
                }

                .topbar h2 {
                    font-size: 22px;
                }
            }

    </style>

</head>


<body>


    <!-- =========================
         SIDEBAR
    ========================== -->

    <div class="sidebar">


        <!-- LOGO -->

        <div class="logo">

            <div class="logo-icon">
                <i class="bi bi-robot"></i>
            </div>

            <h2>ChefIA</h2>

        </div>


        <!-- DASHBOARD -->

        <a asp-controller="Home"
           asp-action="Index"
           class="menu-item">

            <i class="bi bi-house-door-fill"></i>

            Dashboard

        </a>


        <!-- MIS RECETAS -->

        <a asp-controller="Home"
           asp-action="MisRecetas"
           class="menu-item">

            <i class="bi bi-journal-text"></i>

            Mis Recetas

        </a>


        <!-- INGREDIENTES -->

        <a asp-controller="Home"
           asp-action="Ingredientes"
           class="menu-item">

            <i class="bi bi-basket"></i>

            Ingredientes

        </a>


        <!-- AJUSTE INTELIGENTE -->

        <a asp-controller="Home"
           asp-action="AjusteInteligente"
           class="menu-item active">

            <i class="bi bi-stars"></i>

            Ajuste Inteligente

        </a>


        <!-- MI PERFIL -->

        <a asp-controller="Home"
           asp-action="MiPerfil"
           class="menu-item">

            <i class="bi bi-person"></i>
            Mi Perfil

        </a>


        <!-- CERRAR SESIÓN -->

        <a href="#"
           class="menu-item"
           data-bs-toggle="modal"
           data-bs-target="#modalCerrarSesion">

            <i class="bi bi-box-arrow-right"></i>
            Cerrar sesión

        </a>


    </div>


    <!-- =========================
         CONTENIDO
    ========================== -->

    <div class="main-content">


        <!-- ENCABEZADO -->

        <div class="topbar">

            <div class="topbar-title">

                <div class="topbar-icon">

                    <i class="bi bi-stars"></i>

                </div>


                <div>

                    <h2>Ajuste Inteligente</h2>

                    <small class="text-muted">

                        ChefIA recalcula tus ingredientes según las porciones que necesitas.

                    </small>

                </div>

            </div>

        </div>


        <!-- CONTENIDO PRINCIPAL -->

        <div class="ai-layout">


            <!-- =========================
                 FORMULARIO
            ========================== -->

            <div class="adjust-card">


                <div class="ai-header">

                    <div class="ai-icon">

                        <i class="bi bi-robot"></i>

                    </div>


                    <div>

                        <h3>ChefIA está lista para ayudarte</h3>

                        <p>

                            Configura tu receta y calcularemos automáticamente
                            las cantidades.

                        </p>

                    </div>

                </div>


                <!-- MENSAJE DE ERROR -->
                @if (TempData["MensajeError"] != null)
                {
                    <div class="alert alert-danger">

                        @TempData["MensajeError"]

                    </div>
                }


                <!-- FORMULARIO -->

                <form asp-controller="Home"
                      asp-action="AjustarReceta"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- PASO 1 -->

                    <div class="mb-4">

                        <div class="step-label">

                            <div class="step-number">1</div>

                            Selecciona tu receta

                        </div>


                        <select name="recetaId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Selecciona una receta --
                            </option>


                            @if (recetas != null)
                            {
                                foreach (var receta in recetas)
                                {
                                    <option value="@receta.RecetaId">

                                        @receta.Nombre (@receta.Porciones porciones)

                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- PASO 2 -->

                    <div class="mb-4">

                        <div class="step-label">

                            <div class="step-number">2</div>

                            Indica las nuevas porciones

                        </div>


                        <input type="number"
                               name="nuevasPorciones"
                               min="1"
                               class="form-control"
                               placeholder="Ejemplo: 12"
                               required />

                    </div>


                    <!-- BOTÓN -->

                    <button type="submit"
                            class="btn-adjust">

                        <i class="bi bi-magic me-2"></i>

                        Calcular con ChefIA

                    </button>

                </form>


                <!-- INFO -->

                <div class="info-box">

                    <i class="bi bi-lightbulb"></i>


                    <div>

                        <strong>¿Qué hará ChefIA?</strong>

                        <p>

                            Analizará la cantidad original de cada ingrediente
                            y aplicará automáticamente la proporción correcta
                            para las nuevas porciones.

                        </p>

                    </div>

                </div>


            </div>


            <!-- =========================
                 PANEL IA
            ========================== -->

            <div class="ai-panel">


                <div class="ai-panel-icon">

                    <i class="bi bi-cpu"></i>

                </div>


                <h4>Motor inteligente ChefIA</h4>


                <p>

                    Nuestro sistema analiza tu receta y ajusta automáticamente
                    las cantidades necesarias para mantener las proporciones
                    originales.

                </p>


                <!-- FEATURE 1 -->

                <div class="ai-feature">

                    <i class="bi bi-calculator"></i>


                    <div>

                        <strong>Cálculo automático</strong>

                        <span>

                            Recalculamos cada ingrediente utilizando
                            una proporción precisa.

                        </span>

                    </div>

                </div>


                <!-- FEATURE 2 -->

                <div class="ai-feature">

                    <i class="bi bi-graph-up-arrow"></i>


                    <div>

                        <strong>Escalado de receta</strong>

                        <span>

                            Aumenta o reduce tu receta sin perder
                            las proporciones.

                        </span>

                    </div>

                </div>


                <!-- FEATURE 3 -->

                <div class="ai-feature">

                    <i class="bi bi-lightning-charge"></i>


                    <div>

                        <strong>Resultados rápidos</strong>

                        <span>

                            Obtén las nuevas cantidades instantáneamente.

                        </span>

                    </div>

                </div>


            </div>


        </div>


    </div>

    <!-- MODAL CERRAR SESIÓN -->

    <div class="modal fade" id="modalCerrarSesion" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:20px; border:none;">

                <div class="modal-body text-center p-4">

                    <div style="font-size:45px; color:#ff7a00;">
                        <i class="bi bi-box-arrow-right"></i>
                    </div>

                    <h4 class="fw-bold mt-3">
                        ¿Quieres cerrar sesión?
                    </h4>

                    <p class="text-muted">
                        Se cerrará tu sesión actual.
                    </p>

                    <div class="d-flex justify-content-center gap-3 mt-4">

                        <button type="button"
                                class="btn btn-secondary px-4"
                                data-bs-dismiss="modal">
                            No
                        </button>

                        <a asp-controller="Auth"
                           asp-action="CerrarSesion"
                           class="btn px-4"
                           style="background:#ff7a00; color:white;">
                            Sí
                        </a>

                    </div>

                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>