@model IEnumerable<CalculadoraRecetasInteligente.Models.Receta>

@{
    ViewData["Title"] = "Mis Recetas";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>ChefIA - Mis Recetas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            body {
                margin: 0;
                min-height: 100vh;
                font-family: Arial, sans-serif;
                background-color: #f5f6fa;
            }

            /* SIDEBAR */

            .sidebar {
                width: 260px;
                min-height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: linear-gradient(180deg, #ff7a00, #e65c00);
                color: white;
                padding: 25px 20px;
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 45px;
            }

            .logo-icon {
                font-size: 38px;
            }

            .logo h2 {
                margin: 0;
                font-weight: bold;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 14px 15px;
                margin-bottom: 8px;
                border-radius: 12px;
                color: white;
                text-decoration: none;
                transition: 0.3s;
            }

                .menu-item:hover {
                    background-color: rgba(255,255,255,0.20);
                    color: white;
                }

                .menu-item.active {
                    background-color: white;
                    color: #ff7a00;
                    font-weight: bold;
                }

            .logout {
                position: absolute;
                bottom: 30px;
                left: 20px;
                right: 20px;
            }

            /* CONTENIDO */

            .main-content {
                margin-left: 260px;
                padding: 35px;
            }

            /* TOPBAR */

            .topbar {
                background: white;
                border-radius: 18px;
                padding: 18px 25px;
                margin-bottom: 30px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            /* BOTON CREAR */

            .btn-create {
                background-color: #ff7a00;
                color: white;
                border: none;
                border-radius: 10px;
                padding: 12px 20px;
                text-decoration: none;
                font-weight: bold;
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

                .btn-create:hover {
                    background-color: #e65c00;
                    color: white;
                }

            /* BUSCADOR */

            .search-card {
                background: white;
                padding: 20px;
                border-radius: 18px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
                margin-bottom: 25px;
            }

            .search-input {
                border-radius: 12px;
                padding: 12px;
            }

            /* TARJETAS DE RECETAS */

            .recipe-card {
                background: white;
                border-radius: 18px;
                padding: 25px;
                height: 100%;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
                transition: 0.3s;
                border: none;
            }

                .recipe-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 12px 30px rgba(0,0,0,0.10);
                }

            .recipe-badge {
                display: inline-block;
                background-color: #fff0e6;
                color: #ff7a00;
                padding: 6px 12px;
                border-radius: 20px;
                font-size: 13px;
                font-weight: bold;
                margin-bottom: 15px;
            }

            .recipe-card h4 {
                font-weight: bold;
                color: #2f3b4c;
            }

            .recipe-description {
                color: #777;
                min-height: 48px;
            }

            .recipe-info {
                border-top: 1px solid #eee;
                padding-top: 15px;
                margin-top: 15px;
                display: flex;
                justify-content: space-between;
                color: #666;
            }

            .btn-view {
                width: 100%;
                padding: 10px;
                border-radius: 10px;
                border: 1px solid #ff7a00;
                color: #ff7a00;
                background: white;
                text-decoration: none;
                display: inline-block;
                text-align: center;
                font-weight: bold;
            }

                .btn-view:hover {
                    background-color: #ff7a00;
                    color: white;
                }

            /* SIN RECETAS */

            .empty-card {
                background: white;
                border-radius: 18px;
                padding: 60px 30px;
                text-align: center;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            }

            .empty-icon {
                font-size: 70px;
                color: #ff7a00;
                margin-bottom: 20px;
            }

            /* SIN RESULTADOS DE BUSQUEDA */

            #sinResultados {
                display: none;
                text-align: center;
                padding: 30px;
                color: #777;
            }

            @@media (max-width: 768px) {

                .sidebar {
                    position: relative;
                    width: 100%;
                    min-height: auto;
                }

                .logout {
                    position: relative;
                    bottom: auto;
                    left: auto;
                    right: auto;
                    margin-top: 20px;
                }

                .main-content {
                    margin-left: 0;
                    padding: 20px;
                }

                .topbar {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 15px;
                }
            }

    </style>

</head>

<body>

    <!-- SIDEBAR -->

    <div class="sidebar">

        <div class="logo">

            <div class="logo-icon">
                <i class="bi bi-robot"></i>
            </div>

            <h2>ChefIA</h2>

        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="menu-item">

            <i class="bi bi-house-door-fill"></i>
            Dashboard

        </a>

        <a asp-controller="Home"
           asp-action="MisRecetas"
           class="menu-item active">

            <i class="bi bi-journal-text"></i>
            Mis Recetas

        </a>

        <a asp-controller="Home"
           asp-action="Ingredientes"
           class="menu-item">

            <i class="bi bi-basket"></i>

            Ingredientes

        </a>

        <a asp-controller="Home"
           asp-action="AjusteInteligente"
           class="menu-item">

            <i class="bi bi-stars"></i>
            Ajuste Inteligente

        </a>

        <a href="#"
           class="menu-item">

            <i class="bi bi-person"></i>
            Mi Perfil

        </a>

        <div class="logout">

            <a href="#"
               class="menu-item">

                <i class="bi bi-box-arrow-right"></i>
                Cerrar sesión

            </a>

        </div>

    </div>


    <!-- CONTENIDO PRINCIPAL -->

    <div class="main-content">

        <!-- TOPBAR -->

        <div class="topbar">
            
            <div>

                <h4 class="mb-0">
                    Mis Recetas
                </h4>

                <small class="text-muted">
                    Administra y organiza tus recetas guardadas
                </small>

            </div>

            <a asp-controller="Home"
               asp-action="CrearReceta"
               class="btn-create">

                <i class="bi bi-plus-circle"></i>
                Crear receta

            </a>

        </div>


        <!-- BUSCADOR -->

        <div class="search-card">

            <div class="input-group">

                <span class="input-group-text bg-white">

                    <i class="bi bi-search"></i>

                </span>

                <input type="text"
                       id="buscadorRecetas"
                       class="form-control search-input"
                       placeholder="Buscar receta por nombre..." />

            </div>

        </div>


        <!-- RECETAS -->
        @if (Model != null && Model.Any())
        {

            <div class="row g-4" id="contenedorRecetas">

                @foreach (var receta in Model)
                {

                    <div class="col-md-6 col-lg-4 receta-item"
                         data-nombre="@receta.Nombre.ToLower()">

                        <div class="recipe-card">

                            <div class="recipe-badge">

                                <i class="bi bi-journal-text"></i>
                                Receta

                            </div>

                            <h4>
                                @receta.Nombre
                            </h4>

                            <p class="recipe-description">

                                @(string.IsNullOrEmpty(receta.Descripcion)
                                    ? "Sin descripción disponible."
                                    : receta.Descripcion)

                            </p>

                            <div class="recipe-info">

                                <span>

                                    <i class="bi bi-people"></i>
                                    @receta.Porciones porciones

                                </span>

                                <span>

                                    <i class="bi bi-clock"></i>
                                    @receta.TiempoPreparacionMin min

                                </span>

                            </div>


                            <div class="d-flex gap-2 mt-3">

                                <!-- VER -->

                                <a asp-controller="Home"
                                   asp-action="VerReceta"
                                   asp-route-id="@receta.RecetaId"
                                   class="btn-view flex-fill">

                                    <i class="bi bi-eye"></i>
                                    Ver

                                </a>


                                <!-- EDITAR -->

                                <a asp-controller="Home"
                                   asp-action="EditarReceta"
                                   asp-route-id="@receta.RecetaId"
                                   class="btn btn-warning flex-fill">

                                    <i class="bi bi-pencil-square"></i>
                                    Editar

                                </a>


                                <!-- ELIMINAR -->

                                <button type="button"
                                        class="btn btn-danger flex-fill btn-eliminar"
                                        data-id="@receta.RecetaId">

                                    <i class="bi bi-trash"></i>
                                    Eliminar

                                </button>

                            </div>

                        </div>

                    </div>

                }

            </div>


            <!-- MENSAJE SIN RESULTADOS -->

            <div id="sinResultados">

                <i class="bi bi-search"
                   style="font-size: 40px; color: #ff7a00;"></i>

                <h4 class="mt-3">
                    No encontramos recetas
                </h4>

                <p>
                    Intenta buscar con otro nombre.
                </p>

            </div>

        }
        else
        {

            <div class="empty-card">

                <div class="empty-icon">

                    <i class="bi bi-journal-plus"></i>

                </div>

                <h3>
                    Aún no tienes recetas
                </h3>

                <p class="text-muted">

                    Comienza creando tu primera receta
                    y aparecerá aquí.

                </p>

                <a asp-controller="Home"
                   asp-action="CrearReceta"
                   class="btn-create mt-3">

                    <i class="bi bi-plus-circle"></i>
                    Crear mi primera receta

                </a>

            </div>

        }

    </div>


    <!-- MODAL CONFIRMAR ELIMINACIÓN -->

    <div class="modal fade"
         id="modalEliminar"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content"
                 style="border-radius: 20px; border: none;">

                <div class="modal-body text-center p-4">

                    <div style="
                        width: 70px;
                        height: 70px;
                        background: #fff0e6;
                        color: #ff7a00;
                        border-radius: 50%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        margin: 0 auto 20px;
                        font-size: 32px;">

                        <i class="bi bi-trash"></i>

                    </div>

                    <h4 class="fw-bold">
                        ¿Eliminar receta?
                    </h4>

                    <p class="text-muted">

                        ¿Estás seguro de que deseas eliminar esta receta?

                        <br />

                        Esta acción no se puede deshacer.

                    </p>


                    <form id="formEliminar"
                          asp-controller="Home"
                          asp-action="EliminarReceta"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               id="recetaIdEliminar"
                               name="id" />


                        <div class="d-flex gap-2 justify-content-center mt-4">

                            <button type="button"
                                    class="btn btn-light"
                                    data-bs-dismiss="modal"
                                    style="border-radius: 10px; padding: 10px 20px;">

                                Cancelar

                            </button>


                            <button type="submit"
                                    class="btn btn-danger"
                                    style="border-radius: 10px; padding: 10px 20px;">

                                <i class="bi bi-trash"></i>
                                Sí, eliminar

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>


    <!-- JAVASCRIPT BOOTSTRAP -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <!-- JAVASCRIPT ELIMINAR -->

    <script>

            document.querySelectorAll('.btn-eliminar').forEach(boton => {

                boton.addEventListener('click', function() {

                    const recetaId = this.getAttribute('data-id');

                    document.getElementById('recetaIdEliminar').value = recetaId;

                    const modal = new bootstrap.Modal(
                        document.getElementById('modalEliminar')
                    );

                    modal.show();

                });

            });

    </script>


    <!-- JAVASCRIPT BUSCADOR -->

    <script>

            const buscador = document.getElementById('buscadorRecetas');

            if (buscador) {

                buscador.addEventListener('input', function() {

                    const texto = this.value.toLowerCase().trim();

                    const recetas = document.querySelectorAll('.receta-item');

                    let resultados = 0;

                    recetas.forEach(function(receta) {

                        const nombre = receta.getAttribute('data-nombre');

                        if (nombre.includes(texto)) {

                            receta.style.display = '';

                            resultados++;

                        } else {

                            receta.style.display = 'none';

                        }

                    });


                    const sinResultados = document.getElementById('sinResultados');

                    if (sinResultados) {

                        if (resultados === 0 && texto !== '') {

                            sinResultados.style.display = 'block';

                        } else {

                            sinResultados.style.display = 'none';

                        }

                    }

                });

            }

    </script>

</body>
</html>