@model CalculadoraRecetasInteligente.ViewModels.EditarRecetaViewModel

@{
    ViewData["Title"] = "Editar Receta";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>ChefIA - Editar Receta</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            body {
                margin: 0;
                min-height: 100vh;
                font-family: Arial, sans-serif;
                background-color: #f5f6fa;
            }

            .sidebar {
                width: 260px;
                min-height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: linear-gradient(180deg, #ff7a00, #e65c00);
                color: white;
                padding: 25px 20px;
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 45px;
            }

            .logo-icon {
                font-size: 38px;
            }

            .logo h2 {
                margin: 0;
                font-weight: bold;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 14px 15px;
                margin-bottom: 8px;
                border-radius: 12px;
                color: white;
                text-decoration: none;
                transition: 0.3s;
            }

                .menu-item:hover {
                    background-color: rgba(255,255,255,0.20);
                    color: white;
                }

                .menu-item.active {
                    background-color: white;
                    color: #ff7a00;
                    font-weight: bold;
                }

            .logout {
                position: absolute;
                bottom: 30px;
                left: 20px;
                right: 20px;
            }

            .main-content {
                margin-left: 260px;
                padding: 35px;
            }

            .topbar {
                background: white;
                border-radius: 18px;
                padding: 18px 25px;
                margin-bottom: 30px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .form-card {
                background: white;
                border-radius: 22px;
                padding: 40px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            }

            .page-title {
                font-weight: bold;
                color: #2f3b4c;
            }

            .recipe-icon {
                width: 75px;
                height: 75px;
                border-radius: 18px;
                background-color: #fff0e6;
                color: #ff7a00;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 35px;
                margin-bottom: 20px;
            }

            .form-label {
                font-weight: bold;
                color: #2f3b4c;
            }

            .form-control {
                padding: 12px;
                border-radius: 12px;
            }

            textarea.form-control {
                min-height: 120px;
            }

            .btn-save {
                background-color: #ff7a00;
                color: white;
                border: none;
                border-radius: 10px;
                padding: 12px 22px;
                font-weight: bold;
            }

                .btn-save:hover {
                    background-color: #e65c00;
                    color: white;
                }

            .btn-cancel {
                background-color: white;
                color: #666;
                border: 1px solid #ddd;
                border-radius: 10px;
                padding: 12px 22px;
                font-weight: bold;
                text-decoration: none;
            }

                .btn-cancel:hover {
                    background-color: #f5f5f5;
                    color: #333;
                }

            @@media (max-width: 768px) {

                .sidebar {
                    position: relative;
                    width: 100%;
                    min-height: auto;
                }

                .logout {
                    position: relative;
                    bottom: auto;
                    left: auto;
                    right: auto;
                    margin-top: 20px;
                }

                .main-content {
                    margin-left: 0;
                    padding: 20px;
                }

                .topbar {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 15px;
                }

                .form-card {
                    padding: 25px;
                }
            }

    </style>

</head>

<body>

    <!-- SIDEBAR -->

    <div class="sidebar">

        <div class="logo">

            <div class="logo-icon">
                <i class="bi bi-robot"></i>
            </div>

            <h2>ChefIA</h2>

        </div>


        <a asp-controller="Home"
           asp-action="Index"
           class="menu-item">

            <i class="bi bi-house-door-fill"></i>

            Dashboard

        </a>


        <a asp-controller="Home"
           asp-action="MisRecetas"
           class="menu-item active">

            <i class="bi bi-journal-text"></i>

            Mis Recetas

        </a>


        <a href="#"
           class="menu-item">

            <i class="bi bi-basket"></i>

            Ingredientes

        </a>


        <a href="#"
           class="menu-item">

            <i class="bi bi-stars"></i>

            Ajuste Inteligente

        </a>


        <a href="#"
           class="menu-item">

            <i class="bi bi-person"></i>

            Mi Perfil

        </a>


        <div class="logout">

            <a href="#"
               class="menu-item">

                <i class="bi bi-box-arrow-right"></i>

                Cerrar sesión

            </a>

        </div>

    </div>


    <!-- CONTENIDO -->

    <div class="main-content">

        <div class="topbar">

            <div>

                <h4 class="mb-0">
                    Editar receta
                </h4>

                <small class="text-muted">
                    Modifica la información de tu receta
                </small>

            </div>

            <a asp-controller="Home"
               asp-action="MisRecetas"
               class="btn-cancel">

                <i class="bi bi-arrow-left"></i>

                Volver

            </a>

        </div>


        <div class="form-card">

            <div class="recipe-icon">

                <i class="bi bi-pencil-square"></i>

            </div>


            <h2 class="page-title">
                Editar "@Model.Nombre"
            </h2>

            <p class="text-muted mb-4">
                Actualiza los datos de tu receta.
            </p>


            <form asp-action="EditarReceta"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="RecetaId"
                       type="hidden" />


                <div class="mb-4">

                    <label asp-for="Nombre"
                           class="form-label">

                        Nombre de la receta

                    </label>

                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Ejemplo: Pollo con arroz" />

                    <span asp-validation-for="Nombre"
                          class="text-danger"></span>

                </div>


                <div class="mb-4">

                    <label asp-for="Descripcion"
                           class="form-label">

                        Descripción

                    </label>

                    <textarea asp-for="Descripcion"
                              class="form-control"
                              placeholder="Describe brevemente tu receta..."></textarea>

                    <span asp-validation-for="Descripcion"
                          class="text-danger"></span>

                </div>


                <div class="row g-4">


                    <div class="col-md-4">

                        <label asp-for="Porciones"
                               class="form-label">

                            Porciones

                        </label>

                        <input asp-for="Porciones"
                               type="number"
                               class="form-control"
                               min="1" />

                        <span asp-validation-for="Porciones"
                              class="text-danger"></span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="TiempoPreparacionMin"
                               class="form-label">

                            Preparación (min)

                        </label>

                        <input asp-for="TiempoPreparacionMin"
                               type="number"
                               class="form-control"
                               min="0" />

                        <span asp-validation-for="TiempoPreparacionMin"
                              class="text-danger"></span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="TiempoCoccionMin"
                               class="form-label">

                            Cocción (min)

                        </label>

                        <input asp-for="TiempoCoccionMin"
                               type="number"
                               class="form-control"
                               min="0" />

                        <span asp-validation-for="TiempoCoccionMin"
                              class="text-danger"></span>

                    </div>

                </div>


                <div class="d-flex gap-3 mt-5">

                    <button type="submit"
                            class="btn-save">

                        <i class="bi bi-check-circle"></i>

                        Guardar cambios

                    </button>


                    <a asp-controller="Home"
                       asp-action="VerReceta"
                       asp-route-id="@Model.RecetaId"
                       class="btn-cancel">

                        Cancelar

                    </a>

                </div>

            </form>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.20.0/dist/jquery.validate.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

</body>

</html>