@model CalculadoraRecetasInteligente.ViewModels.EditarPerfilViewModel

@{
    ViewData["Title"] = "Editar Perfil";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>ChefIA - Editar Perfil</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            body {
                margin: 0;
                min-height: 100vh;
                font-family: Arial, sans-serif;
                background-color: #f5f6fa;
            }

            .sidebar {
                width: 260px;
                min-height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: linear-gradient(180deg, #ff7a00, #e65c00);
                color: white;
                padding: 25px 20px;
                display: flex;
                flex-direction: column;
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 45px;
            }

            .logo-icon {
                font-size: 38px;
            }

            .logo h2 {
                margin: 0;
                font-weight: bold;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 14px 15px;
                margin-bottom: 8px;
                border-radius: 12px;
                color: white;
                text-decoration: none;
                transition: 0.3s;
            }

                .menu-item:hover {
                    background-color: rgba(255,255,255,0.20);
                    color: white;
                }

                .menu-item.active {
                    background-color: white;
                    color: #ff7a00;
                    font-weight: bold;
                }

            .logout {
                margin-top: auto;
            }

            .main-content {
                margin-left: 260px;
                padding: 35px;
                max-width: 1500px;
            }

            .topbar {
                background: white;
                border-radius: 20px;
                padding: 25px 30px;
                margin-bottom: 30px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            }

                .topbar h2 {
                    margin: 0;
                    color: #2f3b4c;
                    font-weight: bold;
                }

            .form-card {
                background: white;
                border-radius: 22px;
                padding: 40px;
                max-width: 850px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            }

            .profile-icon {
                width: 80px;
                height: 80px;
                border-radius: 20px;
                background: #fff0e6;
                color: #ff7a00;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 38px;
                margin-bottom: 25px;
            }

            .form-label {
                font-weight: bold;
                color: #2f3b4c;
            }

            .form-control {
                border-radius: 12px;
                padding: 13px;
            }

                .form-control:focus {
                    border-color: #ff7a00;
                    box-shadow: 0 0 0 0.2rem rgba(255,122,0,0.15);
                }

            .btn-save {
                background-color: #ff7a00;
                color: white;
                border: none;
                border-radius: 10px;
                padding: 12px 22px;
                font-weight: bold;
            }

                .btn-save:hover {
                    background-color: #e65c00;
                    color: white;
                }

            .btn-cancel {
                border-radius: 10px;
                padding: 12px 22px;
            }

            @@media (max-width: 768px) {

                .sidebar {
                    position: relative;
                    width: 100%;
                    min-height: auto;
                }

                .main-content {
                    margin-left: 0;
                    padding: 20px;
                }

                .form-card {
                    padding: 25px;
                }
            }

    </style>

</head>

<body>

    <!-- SIDEBAR -->

    <div class="sidebar">

        <div class="logo">

            <div class="logo-icon">
                <i class="bi bi-robot"></i>
            </div>

            <h2>ChefIA</h2>

        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="menu-item">

            <i class="bi bi-house-door-fill"></i>
            Dashboard

        </a>

        <a asp-controller="Home"
           asp-action="MisRecetas"
           class="menu-item">

            <i class="bi bi-journal-text"></i>
            Mis Recetas

        </a>

        <a asp-controller="Home"
           asp-action="Ingredientes"
           class="menu-item">

            <i class="bi bi-basket"></i>
            Ingredientes

        </a>

        <a asp-controller="Home"
           asp-action="AjusteInteligente"
           class="menu-item">

            <i class="bi bi-stars"></i>
            Ajuste Inteligente

        </a>

        <a asp-controller="Home"
           asp-action="MiPerfil"
           class="menu-item active">

            <i class="bi bi-person"></i>
            Mi Perfil

        </a>

        <a href="#"
           class="menu-item"
           data-bs-toggle="modal"
           data-bs-target="#modalCerrarSesion">

            <i class="bi bi-box-arrow-right"></i>
            Cerrar sesión

        </a>

    </div>


    <!-- CONTENIDO -->

    <div class="main-content">

        <div class="topbar">

            <h2>Editar Perfil</h2>

            <small class="text-muted">
                Actualiza la información de tu cuenta
            </small>

        </div>


        <div class="form-card">

            <div class="profile-icon">

                <i class="bi bi-person-fill"></i>

            </div>

            <h3 class="mb-4">
                Información personal
            </h3>


            <form asp-controller="Home"
                  asp-action="EditarPerfil"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="UsuarioId"
                       type="hidden" />


                <!-- NOMBRE -->

                <div class="mb-3">

                    <label asp-for="Nombre"
                           class="form-label">

                        Nombre

                    </label>

                    <input asp-for="Nombre"
                           class="form-control" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>

                </div>


                <!-- APELLIDO -->

                <div class="mb-3">

                    <label asp-for="Apellido"
                           class="form-label">

                        Apellido

                    </label>

                    <input asp-for="Apellido"
                           class="form-control" />

                    <span asp-validation-for="Apellido"
                          class="text-danger">
                    </span>

                </div>


                <!-- CORREO -->

                <div class="mb-4">

                    <label asp-for="Correo"
                           class="form-label">

                        Correo electrónico

                    </label>

                    <input asp-for="Correo"
                           type="email"
                           class="form-control" />

                    <span asp-validation-for="Correo"
                          class="text-danger">
                    </span>

                </div>


                <!-- BOTONES -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn-save">

                        <i class="bi bi-check-circle me-1"></i>

                        Guardar cambios

                    </button>

                    <a asp-controller="Home"
                       asp-action="MiPerfil"
                       class="btn btn-secondary btn-cancel">

                        Cancelar

                    </a>

                </div>

            </form>

        </div>

    </div>

    <!-- MODAL CERRAR SESIÓN -->

    <div class="modal fade" id="modalCerrarSesion" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:20px; border:none;">

                <div class="modal-body text-center p-4">

                    <div style="font-size:45px; color:#ff7a00;">
                        <i class="bi bi-box-arrow-right"></i>
                    </div>

                    <h4 class="fw-bold mt-3">
                        ¿Quieres cerrar sesión?
                    </h4>

                    <p class="text-muted">
                        Se cerrará tu sesión actual.
                    </p>

                    <div class="d-flex justify-content-center gap-3 mt-4">

                        <button type="button"
                                class="btn btn-secondary px-4"
                                data-bs-dismiss="modal">
                            No
                        </button>

                        <a asp-controller="Auth"
                           asp-action="CerrarSesion"
                           class="btn px-4"
                           style="background:#ff7a00; color:white;">
                            Sí
                        </a>

                    </div>

                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>