@model CalculadoraRecetasInteligente.ViewModels.CrearRecetaViewModel

@{
    ViewData["Title"] = "Crear Receta";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>ChefIA - Crear Receta</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            body {
                margin: 0;
                min-height: 100vh;
                font-family: Arial, sans-serif;
                background-color: #f5f6fa;
            }

            /* SIDEBAR */

            .sidebar {
                width: 260px;
                min-height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: linear-gradient(180deg, #ff7a00, #e65c00);
                color: white;
                padding: 25px 20px;
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 45px;
            }

            .logo-icon {
                font-size: 38px;
            }

            .logo h2 {
                margin: 0;
                font-weight: bold;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 14px 15px;
                margin-bottom: 8px;
                border-radius: 12px;
                color: white;
                text-decoration: none;
                transition: 0.3s;
            }

                .menu-item:hover {
                    background-color: rgba(255,255,255,0.20);
                    color: white;
                }

                .menu-item.active {
                    background-color: white;
                    color: #ff7a00;
                    font-weight: bold;
                }

            .logout {
                position: absolute;
                bottom: 30px;
                left: 20px;
                right: 20px;
            }

            /* CONTENIDO */

            .main-content {
                margin-left: 260px;
                padding: 35px;
            }

            .topbar {
                background: white;
                border-radius: 18px;
                padding: 18px 25px;
                margin-bottom: 30px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .user-avatar {
                width: 45px;
                height: 45px;
                background: #fff0e6;
                color: #ff7a00;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
            }

            /* FORMULARIO */

            .form-card {
                background: white;
                border-radius: 20px;
                padding: 35px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            }

            .form-title {
                font-weight: bold;
                margin-bottom: 8px;
            }

            .form-subtitle {
                color: #777;
                margin-bottom: 30px;
            }

            .form-label {
                font-weight: bold;
            }

            .form-control {
                border-radius: 12px;
                padding: 12px;
            }

            .input-group-text {
                border-radius: 12px 0 0 12px;
                background: #fff0e6;
                color: #ff7a00;
            }

            .form-control:focus {
                border-color: #ff7a00;
                box-shadow: 0 0 0 0.2rem rgba(255,122,0,0.15);
            }

            textarea.form-control {
                resize: vertical;
                min-height: 120px;
            }

            .section-title {
                font-weight: bold;
                font-size: 1.2rem;
                margin-top: 30px;
                margin-bottom: 20px;
                color: #333;
            }

            .btn-save {
                background-color: #ff7a00;
                border: none;
                color: white;
                padding: 12px 25px;
                border-radius: 12px;
                font-weight: bold;
            }

                .btn-save:hover {
                    background-color: #e65c00;
                    color: white;
                }

            .btn-cancel {
                border-radius: 12px;
                padding: 12px 25px;
                font-weight: bold;
            }

            @@media (max-width: 768px) {

                .sidebar {
                    position: relative;
                    width: 100%;
                    min-height: auto;
                }

                .logout {
                    position: relative;
                    bottom: auto;
                    left: auto;
                    right: auto;
                    margin-top: 20px;
                }

                .main-content {
                    margin-left: 0;
                    padding: 20px;
                }
            }

    </style>

</head>

<body>

    <!-- SIDEBAR -->

    <div class="sidebar">

        <div class="logo">

            <div class="logo-icon">
                <i class="bi bi-robot"></i>
            </div>

            <h2>ChefIA</h2>

        </div>


        <a asp-controller="Home"
           asp-action="Index"
           class="menu-item">

            <i class="bi bi-house-door-fill"></i>

            Dashboard

        </a>


        <a asp-controller="Home"
           asp-action="MisRecetas"
           class="menu-item">

            <i class="bi bi-journal-text"></i>

            Mis Recetas

        </a>


        <a href="#"
           class="menu-item active">

            <i class="bi bi-plus-circle"></i>

            Crear Receta

        </a>


        <a href="#"
           class="menu-item">

            <i class="bi bi-basket"></i>

            Ingredientes

        </a>


        <a href="#"
           class="menu-item">

            <i class="bi bi-stars"></i>

            Ajuste Inteligente

        </a>


        <a href="#"
           class="menu-item">

            <i class="bi bi-person"></i>

            Mi Perfil

        </a>


        <div class="logout">

            <a href="#"
               class="menu-item">

                <i class="bi bi-box-arrow-right"></i>

                Cerrar sesión

            </a>

        </div>

    </div>


    <!-- CONTENIDO PRINCIPAL -->

    <div class="main-content">


        <!-- TOPBAR -->

        <div class="topbar">

            <div>

                <h4 class="mb-0">
                    Crear nueva receta
                </h4>

                <small class="text-muted">
                    Agrega los datos principales de tu receta
                </small>

            </div>


            <div class="user-info">

                <div>

                    <strong>Chef</strong>

                    <br />

                    <small class="text-muted">
                        Usuario ChefIA
                    </small>

                </div>


                <div class="user-avatar">

                    <i class="bi bi-person-fill"></i>

                </div>

            </div>

        </div>


        <!-- FORMULARIO -->

        <div class="form-card">

            <h2 class="form-title">

                <i class="bi bi-journal-plus"></i>

                Nueva receta

            </h2>


            <p class="form-subtitle">

                Completa la información para registrar tu receta.

            </p>


            <form asp-controller="Home"
                  asp-action="CrearReceta"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- INFORMACIÓN PRINCIPAL -->

                <div class="section-title">

                    <i class="bi bi-info-circle"></i>

                    Información principal

                </div>


                <div class="row g-4">


                    <!-- NOMBRE -->

                    <div class="col-md-8">

                        <label asp-for="Nombre"
                               class="form-label">

                            Nombre de la receta

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-card-text"></i>

                            </span>

                            <input asp-for="Nombre"
                                   type="text"
                                   class="form-control"
                                   placeholder="Ejemplo: Pasta Alfredo" />

                        </div>

                        <span asp-validation-for="Nombre"
                              class="text-danger"></span>

                    </div>


                    <!-- PORCIONES -->

                    <div class="col-md-4">

                        <label asp-for="Porciones"
                               class="form-label">

                            Porciones

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-people"></i>

                            </span>

                            <input asp-for="Porciones"
                                   type="number"
                                   class="form-control"
                                   placeholder="4" />

                        </div>

                        <span asp-validation-for="Porciones"
                              class="text-danger"></span>

                    </div>


                    <!-- DESCRIPCIÓN -->

                    <div class="col-12">

                        <label asp-for="Descripcion"
                               class="form-label">

                            Descripción

                        </label>

                        <textarea asp-for="Descripcion"
                                  class="form-control"
                                  placeholder="Describe brevemente tu receta..."></textarea>

                        <span asp-validation-for="Descripcion"
                              class="text-danger"></span>

                    </div>

                </div>


                <!-- TIEMPOS -->

                <div class="section-title">

                    <i class="bi bi-clock"></i>

                    Tiempo de preparación

                </div>


                <div class="row g-4">


                    <!-- PREPARACIÓN -->

                    <div class="col-md-6">

                        <label asp-for="TiempoPreparacionMin"
                               class="form-label">

                            Tiempo de preparación (minutos)

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-clock"></i>

                            </span>

                            <input asp-for="TiempoPreparacionMin"
                                   type="number"
                                   class="form-control"
                                   placeholder="20" />

                        </div>

                        <span asp-validation-for="TiempoPreparacionMin"
                              class="text-danger"></span>

                    </div>


                    <!-- COCCIÓN -->

                    <div class="col-md-6">

                        <label asp-for="TiempoCoccionMin"
                               class="form-label">

                            Tiempo de cocción (minutos)

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-fire"></i>

                            </span>

                            <input asp-for="TiempoCoccionMin"
                                   type="number"
                                   class="form-control"
                                   placeholder="30" />

                        </div>

                        <span asp-validation-for="TiempoCoccionMin"
                              class="text-danger"></span>

                    </div>


                </div>


                <!-- BOTONES -->

                <div class="mt-5 d-flex gap-3">


                    <a asp-controller="Home"
                       asp-action="MisRecetas"
                       class="btn btn-light btn-cancel">

                        <i class="bi bi-arrow-left"></i>

                        Cancelar

                    </a>


                    <button type="submit"
                            class="btn btn-save">

                        <i class="bi bi-check-circle"></i>

                        Guardar receta

                    </button>

                    
                </div>


            </form>

        </div>


    </div>


    <!-- VALIDACIONES -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.20.0/dist/jquery.validate.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

</body>

</html>