@model IEnumerable<CalculadoraRecetasInteligente.Models.Ingrediente>

@{
    ViewData["Title"] = "Ingredientes";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>ChefIA - Ingredientes</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            body {
                margin: 0;
                min-height: 100vh;
                font-family: Arial, sans-serif;
                background-color: #f5f6fa;
            }

            /* SIDEBAR */

            .sidebar {
                width: 260px;
                min-height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: linear-gradient(180deg, #ff7a00, #e65c00);
                color: white;
                padding: 25px 20px;
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 45px;
            }

            .logo-icon {
                font-size: 38px;
            }

            .logo h2 {
                margin: 0;
                font-weight: bold;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 14px 15px;
                margin-bottom: 8px;
                border-radius: 12px;
                color: white;
                text-decoration: none;
                transition: 0.3s;
            }

                .menu-item:hover {
                    background-color: rgba(255,255,255,0.20);
                    color: white;
                }

                .menu-item.active {
                    background-color: white;
                    color: #ff7a00;
                    font-weight: bold;
                }

            .logout {
                position: absolute;
                bottom: 30px;
                left: 20px;
                right: 20px;
            }

            /* CONTENIDO */

            .main-content {
                margin-left: 260px;
                padding: 35px;
            }

            .topbar {
                background: white;
                border-radius: 18px;
                padding: 18px 25px;
                margin-bottom: 30px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .btn-create {
                background-color: #ff7a00;
                color: white;
                border: none;
                border-radius: 10px;
                padding: 12px 20px;
                text-decoration: none;
                font-weight: bold;
            }

                .btn-create:hover {
                    background-color: #e65c00;
                    color: white;
                }

            /* TARJETAS */

            .ingredient-card {
                background: white;
                border-radius: 18px;
                padding: 22px;
                height: 100%;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
                transition: 0.3s;
            }

                .ingredient-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 12px 30px rgba(0,0,0,0.10);
                }

            .ingredient-icon {
                width: 55px;
                height: 55px;
                border-radius: 15px;
                background: #fff0e6;
                color: #ff7a00;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 25px;
                margin-bottom: 18px;
            }

            .ingredient-name {
                font-size: 20px;
                font-weight: bold;
                color: #2f3b4c;
            }

            .ingredient-info {
                color: #777;
                margin-top: 8px;
            }

            .empty-card {
                background: white;
                border-radius: 18px;
                padding: 60px 30px;
                text-align: center;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            }

            .empty-icon {
                font-size: 70px;
                color: #ff7a00;
                margin-bottom: 20px;
            }

            @@media (max-width: 768px) {

                .sidebar {
                    position: relative;
                    width: 100%;
                    min-height: auto;
                }

                .logout {
                    position: relative;
                    bottom: auto;
                    left: auto;
                    right: auto;
                    margin-top: 20px;
                }

                .main-content {
                    margin-left: 0;
                    padding: 20px;
                }

                .topbar {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 15px;
                }
            }

    </style>

</head>

<body>

    <!-- SIDEBAR -->

    <div class="sidebar">

        <div class="logo">

            <div class="logo-icon">
                <i class="bi bi-robot"></i>
            </div>

            <h2>ChefIA</h2>

        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="menu-item">

            <i class="bi bi-house-door-fill"></i>
            Dashboard

        </a>

        <a asp-controller="Home"
           asp-action="MisRecetas"
           class="menu-item">

            <i class="bi bi-journal-text"></i>
            Mis Recetas

        </a>

        <a asp-controller="Home"
           asp-action="Ingredientes"
           class="menu-item active">

            <i class="bi bi-basket"></i>
            Ingredientes

        </a>

        <a asp-controller="Home"
           asp-action="AjusteInteligente"
           class="menu-item">

            <i class="bi bi-stars"></i>
            Ajuste Inteligente

        </a>

        <a href="#"
           class="menu-item">

            <i class="bi bi-person"></i>
            Mi Perfil

        </a>

        <div class="logout">

            <a href="#"
               class="menu-item">

                <i class="bi bi-box-arrow-right"></i>
                Cerrar sesión

            </a>

        </div>

    </div>


    <!-- CONTENIDO -->

    <div class="main-content">

        <div class="topbar">

            <div>

                <h4 class="mb-0">
                    Ingredientes
                </h4>

                <small class="text-muted">
                    Administra los ingredientes de tus recetas
                </small>

            </div>

            <a asp-controller="Home"
               asp-action="CrearIngrediente"
               class="btn-create">

                <i class="bi bi-plus-circle"></i>
                Agregar ingrediente

            </a>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="row g-4">

                @foreach (var ingrediente in Model)
                {
                    <div class="col-md-6 col-lg-4">

                        <div class="ingredient-card">

                            <div class="ingredient-icon">
                                <i class="bi bi-basket"></i>
                            </div>

                            <div class="ingredient-name">
                                @ingrediente.Nombre
                            </div>

                            <div class="ingredient-info">

                                <i class="bi bi-box-seam"></i>

                                @ingrediente.Cantidad
                                @ingrediente.UnidadMedida

                            </div>

                            <div class="d-flex gap-2 mt-4">

                                <a asp-controller="Home"
                                   asp-action="EditarIngrediente"
                                   asp-route-id="@ingrediente.IngredienteId"
                                   class="btn btn-warning flex-fill">

                                    <i class="bi bi-pencil-square"></i>
                                    Editar

                                </a>

                                <button type="button"
                                        class="btn btn-danger flex-fill btn-eliminar"
                                        data-id="@ingrediente.IngredienteId">

                                    <i class="bi bi-trash"></i>
                                    Eliminar

                                </button>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-card">

                <div class="empty-icon">
                    <i class="bi bi-basket"></i>
                </div>
                
                <h3>
                    Aún no tienes ingredientes
                </h3>

                <p class="text-muted">
                    Agrega tus ingredientes para comenzar a organizar tus recetas.
                </p>

                <a asp-controller="Home"
                   asp-action="CrearIngrediente"
                   class="btn-create mt-3">

                    <i class="bi bi-plus-circle"></i>
                    Agregar mi primer ingrediente

                </a>

            </div>
        }

    </div>

    <!-- MODAL ELIMINAR INGREDIENTE -->

    <div class="modal fade"
         id="modalEliminar"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content"
                 style="border-radius: 20px; border: none;">

                <div class="modal-body text-center p-4">

                    <div style="
                        width: 70px;
                        height: 70px;
                        background: #fff0e6;
                        color: #ff7a00;
                        border-radius: 50%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        margin: 0 auto 20px;
                        font-size: 32px;">

                        <i class="bi bi-trash"></i>

                    </div>

                    <h4 class="fw-bold">
                        ¿Eliminar ingrediente?
                    </h4>

                    <p class="text-muted">
                        ¿Estás seguro de que deseas eliminar este ingrediente?
                        <br />
                        Esta acción no se puede deshacer.
                    </p>

                    <form asp-controller="Home"
                          asp-action="EliminarIngrediente"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               id="ingredienteIdEliminar"
                               name="id" />

                        <div class="d-flex gap-2 justify-content-center mt-4">

                            <button type="button"
                                    class="btn btn-light"
                                    data-bs-dismiss="modal">

                                Cancelar

                            </button>

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-trash"></i>
                                Sí, eliminar

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>

            document.querySelectorAll('.btn-eliminar').forEach(boton => {

                boton.addEventListener('click', function() {

                    const ingredienteId = this.getAttribute('data-id');

                    document.getElementById('ingredienteIdEliminar').value = ingredienteId;

                    const modal = new bootstrap.Modal(
                        document.getElementById('modalEliminar')
                    );

                    modal.show();

                });

            });

    </script>

</body>
</html>