@model CalculadoraRecetasInteligente.ViewModels.ResultadoAjusteViewModel

@{
    ViewData["Title"] = "Resultado del Ajuste";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>ChefIA - Resultado del Ajuste</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            body {
                margin: 0;
                min-height: 100vh;
                font-family: Arial, sans-serif;
                background-color: #f5f6fa;
            }

            /* SIDEBAR */

            .sidebar {
                width: 260px;
                min-height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: linear-gradient(180deg, #ff7a00, #e65c00);
                color: white;
                padding: 25px 20px;
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 45px;
            }

            .logo-icon {
                font-size: 38px;
            }

            .logo h2 {
                margin: 0;
                font-weight: bold;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 14px 15px;
                margin-bottom: 8px;
                border-radius: 12px;
                color: white;
                text-decoration: none;
            }

                .menu-item:hover {
                    background-color: rgba(255,255,255,0.20);
                    color: white;
                }

                .menu-item.active {
                    background-color: white;
                    color: #ff7a00;
                    font-weight: bold;
                }

            .logout {
                position: absolute;
                bottom: 30px;
                left: 20px;
                right: 20px;
            }

            /* CONTENIDO */

            .main-content {
                margin-left: 260px;
                padding: 35px;
            }

            .topbar {
                background: white;
                border-radius: 18px;
                padding: 25px;
                margin-bottom: 30px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            }

            .result-card {
                background: white;
                border-radius: 18px;
                padding: 35px;
                max-width: 900px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            }

            .result-icon {
                width: 70px;
                height: 70px;
                border-radius: 18px;
                background: #fff0e6;
                color: #ff7a00;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 32px;
                margin-bottom: 20px;
            }

            .ingredient-row {
                padding: 18px;
                border-radius: 12px;
                background: #f8f9fa;
                margin-bottom: 12px;
            }

            .new-quantity {
                font-size: 20px;
                font-weight: bold;
                color: #ff7a00;
            }

            .btn-back {
                background: #ff7a00;
                color: white;
                border: none;
                border-radius: 10px;
                padding: 12px 22px;
                text-decoration: none;
                font-weight: bold;
                display: inline-block;
            }

                .btn-back:hover {
                    background: #e65c00;
                    color: white;
                }

    </style>

</head>

<body>

    <!-- SIDEBAR -->

    <div class="sidebar">

        <div class="logo">

            <div class="logo-icon">
                <i class="bi bi-robot"></i>
            </div>

            <h2>ChefIA</h2>

        </div>


        <a asp-controller="Home"
           asp-action="Index"
           class="menu-item">

            <i class="bi bi-house-door-fill"></i>
            Dashboard

        </a>


        <a asp-controller="Home"
           asp-action="MisRecetas"
           class="menu-item">

            <i class="bi bi-journal-text"></i>
            Mis Recetas

        </a>


        <a asp-controller="Home"
           asp-action="Ingredientes"
           class="menu-item">

            <i class="bi bi-basket"></i>
            Ingredientes

        </a>


        <a asp-controller="Home"
           asp-action="AjusteInteligente"
           class="menu-item active">

            <i class="bi bi-stars"></i>
            Ajuste Inteligente

        </a>


        <a asp-controller="Home"
           asp-action="MiPerfil"
           class="menu-item">

            <i class="bi bi-person"></i>
            Mi Perfil

        </a>


        <div class="logout">

            <a asp-controller="Home"
               asp-action="CerrarSesion"
               class="menu-item">

                <i class="bi bi-box-arrow-right"></i>
                Cerrar sesión

            </a>

        </div>

    </div>


    <!-- CONTENIDO -->

    <div class="main-content">

        <div class="topbar">

            <h2 class="mb-1">
                🤖 Resultado del Ajuste Inteligente
            </h2>

            <p class="text-muted mb-0">
                ChefIA calculó automáticamente las nuevas cantidades.
            </p>

        </div>


        <div class="result-card">

            <div class="result-icon">
                <i class="bi bi-stars"></i>
            </div>


            <h3>@Model.NombreReceta</h3>

            <p class="text-muted">
                Ajustada de
                <strong>@Model.PorcionesOriginales</strong>
                a
                <strong>@Model.NuevasPorciones</strong>
                porciones.
            </p>


            <hr />


            <h5 class="mb-4">
                <i class="bi bi-basket"></i>
                Nuevas cantidades
            </h5>


            @foreach (var ingrediente in Model.Ingredientes)
            {
                <div class="ingredient-row d-flex justify-content-between align-items-center">

                    <div>

                        <strong>
                            @ingrediente.Nombre
                        </strong>

                        <div class="text-muted">

                            Cantidad original:
                            @ingrediente.CantidadOriginal
                            @ingrediente.UnidadMedida

                        </div>

                    </div>


                    <div class="new-quantity">

                        @ingrediente.NuevaCantidad
                        @ingrediente.UnidadMedida

                    </div>

                </div>
            }


            <div class="mt-4">

                <a asp-controller="Home"
                   asp-action="AjusteInteligente"
                   class="btn-back">

                    <i class="bi bi-arrow-left"></i>

                    Realizar otro ajuste

                </a>

            </div>

        </div>

    </div>

</body>

</html>