@model CalculadoraRecetasInteligente.ViewModels.EditarIngredienteViewModel

@{
    ViewData["Title"] = "Editar Ingrediente";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>ChefIA - Editar Ingrediente</title>


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <style>

            body {
                margin: 0;
                min-height: 100vh;
                font-family: Arial, sans-serif;
                background-color: #f5f6fa;
            }


            /* SIDEBAR */

            .sidebar {
                width: 260px;
                min-height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: linear-gradient(180deg, #ff7a00, #e65c00);
                color: white;
                padding: 25px 20px;
            }


            .logo {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 45px;
            }


            .logo-icon {
                font-size: 38px;
            }


            .logo h2 {
                margin: 0;
                font-weight: bold;
            }


            .menu-item {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 14px 15px;
                margin-bottom: 8px;
                border-radius: 12px;
                color: white;
                text-decoration: none;
                transition: 0.3s;
            }


                .menu-item:hover {
                    background-color: rgba(255,255,255,0.20);
                    color: white;
                }


                .menu-item.active {
                    background-color: white;
                    color: #ff7a00;
                    font-weight: bold;
                }


            .logout {
                position: absolute;
                bottom: 30px;
                left: 20px;
                right: 20px;
            }


            /* CONTENIDO */

            .main-content {
                margin-left: 260px;
                padding: 35px;
            }


            .topbar {
                background: white;
                border-radius: 18px;
                padding: 18px 25px;
                margin-bottom: 30px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            }


            .form-card {
                background: white;
                border-radius: 18px;
                padding: 35px;
                max-width: 750px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            }


            .form-label {
                font-weight: bold;
                color: #2f3b4c;
            }


            .form-control {
                border-radius: 10px;
                padding: 12px;
            }


            .btn-save {
                background-color: #ff7a00;
                color: white;
                border: none;
                border-radius: 10px;
                padding: 12px 22px;
                font-weight: bold;
            }


                .btn-save:hover {
                    background-color: #e65c00;
                    color: white;
                }


            .btn-cancel {
                border-radius: 10px;
                padding: 12px 22px;
            }


            @@media (max-width: 768px) {

                .sidebar {
                    position: relative;
                    width: 100%;
                    min-height: auto;
                }


                .logout {
                    position: relative;
                    bottom: auto;
                    left: auto;
                    right: auto;
                    margin-top: 20px;
                }


                .main-content {
                    margin-left: 0;
                    padding: 20px;
                }
            }

    </style>

</head>


<body>


    <!-- SIDEBAR -->

    <div class="sidebar">


        <div class="logo">

            <div class="logo-icon">
                <i class="bi bi-robot"></i>
            </div>

            <h2>ChefIA</h2>

        </div>


        <a asp-controller="Home"
           asp-action="Index"
           class="menu-item">

            <i class="bi bi-house-door-fill"></i>

            Dashboard

        </a>


        <a asp-controller="Home"
           asp-action="MisRecetas"
           class="menu-item">

            <i class="bi bi-journal-text"></i>

            Mis Recetas

        </a>


        <a asp-controller="Home"
           asp-action="Ingredientes"
           class="menu-item active">

            <i class="bi bi-basket"></i>

            Ingredientes

        </a>


        <a href="#"
           class="menu-item">

            <i class="bi bi-stars"></i>

            Ajuste Inteligente

        </a>


        <a href="#"
           class="menu-item">

            <i class="bi bi-person"></i>

            Mi Perfil

        </a>


        <div class="logout">

            <a href="#"
               class="menu-item">

                <i class="bi bi-box-arrow-right"></i>

                Cerrar sesión

            </a>

        </div>


    </div>


    <!-- CONTENIDO -->

    <div class="main-content">


        <div class="topbar">

            <h4 class="mb-0">
                Editar Ingrediente
            </h4>

            <small class="text-muted">
                Actualiza la información de tu ingrediente
            </small>

        </div>


        <div class="form-card">
            

            <form asp-action="EditarIngrediente"
                  method="post">


                @Html.AntiForgeryToken()

                <input asp-for="IngredienteId" type="hidden" />


                <!-- ID OCULTO -->

                <input asp-for="IngredienteId"
                       type="hidden" />


                <!-- NOMBRE -->

                <div class="mb-3">

                    <label asp-for="Nombre"
                           class="form-label">

                        Nombre del ingrediente

                    </label>


                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Ejemplo: Harina" />


                    <span asp-validation-for="Nombre"
                          class="text-danger"></span>

                </div>


                <!-- CANTIDAD -->

                <div class="mb-3">

                    <label asp-for="Cantidad"
                           class="form-label">

                        Cantidad

                    </label>


                    <input asp-for="Cantidad"
                           type="number"
                           step="0.01"
                           class="form-control" />


                    <span asp-validation-for="Cantidad"
                          class="text-danger"></span>

                </div>


                <!-- UNIDAD -->

                <div class="mb-4">

                    <label asp-for="UnidadMedida"
                           class="form-label">

                        Unidad de medida

                    </label>
                    

                    <input asp-for="UnidadMedida"
                           class="form-control"
                           placeholder="Ejemplo: kg, gramos, litros" />


                    <span asp-validation-for="UnidadMedida"
                          class="text-danger"></span>

                </div>


                <!-- BOTONES -->

                <div class="d-flex gap-2">


                    <button type="submit"
                            class="btn btn-save">

                        <i class="bi bi-check-circle"></i>

                        Guardar cambios

                    </button>


                    <a asp-action="Ingredientes"
                       class="btn btn-secondary btn-cancel">

                        Cancelar

                    </a>


                </div>


            </form>


        </div>


    </div>


</body>

</html>