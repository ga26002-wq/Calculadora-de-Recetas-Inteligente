@{
    ViewData["Title"] = "Dashboard";
    Layout = null;

    var nombreUsuario = ViewBag.UsuarioNombre ?? "Chef";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>ChefIA - Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            body {
                margin: 0;
                min-height: 100vh;
                font-family: Arial, sans-serif;
                background-color: #f5f6fa;
            }

            /* SIDEBAR */

            .sidebar {
                width: 260px;
                min-height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: linear-gradient(180deg, #ff7a00, #e65c00);
                color: white;
                padding: 25px 20px;
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 45px;
            }

            .logo-icon {
                font-size: 38px;
            }

            .logo h2 {
                margin: 0;
                font-weight: bold;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 14px 15px;
                margin-bottom: 8px;
                border-radius: 12px;
                color: white;
                text-decoration: none;
                transition: 0.3s;
            }

                .menu-item:hover {
                    background-color: rgba(255,255,255,0.20);
                    color: white;
                }

                .menu-item.active {
                    background-color: white;
                    color: #ff7a00;
                    font-weight: bold;
                }

            .logout {
                position: absolute;
                bottom: 30px;
                left: 20px;
                right: 20px;
            }

            /* CONTENIDO */

            .main-content {
                margin-left: 260px;
                padding: 35px;
            }

            .topbar {
                background: white;
                border-radius: 18px;
                padding: 18px 25px;
                margin-bottom: 30px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .user-avatar {
                width: 45px;
                height: 45px;
                background: #fff0e6;
                color: #ff7a00;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
            }

            /* BIENVENIDA */

            .welcome-card {
                background: linear-gradient(135deg, #ff7a00, #ff9d2e);
                color: white;
                padding: 35px;
                border-radius: 20px;
                margin-bottom: 30px;
                position: relative;
                overflow: hidden;
            }

                .welcome-card h1 {
                    font-weight: bold;
                }

            .welcome-icon {
                position: absolute;
                right: 40px;
                bottom: 20px;
                font-size: 110px;
                opacity: 0.25;
            }

            /* TARJETAS */

            .feature-card {
                background: white;
                border-radius: 18px;
                padding: 25px;
                height: 100%;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
                transition: 0.3s;
                border: none;
            }

                .feature-card:hover {
                    transform: translateY(-6px);
                    box-shadow: 0 12px 30px rgba(0,0,0,0.10);
                }

            .feature-icon {
                width: 60px;
                height: 60px;
                border-radius: 15px;
                background: #fff0e6;
                color: #ff7a00;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 28px;
                margin-bottom: 18px;
            }

            .feature-card h4 {
                font-weight: bold;
            }

            .feature-card p {
                color: #777;
            }

            .btn-feature {
                background-color: #ff7a00;
                color: white;
                border: none;
                border-radius: 10px;
                padding: 10px 18px;
                text-decoration: none;
                display: inline-block;
                font-weight: bold;
            }

                .btn-feature:hover {
                    background-color: #e65c00;
                    color: white;
                }

            /* ESTADÍSTICAS */

            .stat-card {
                background: white;
                padding: 22px;
                border-radius: 18px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            }

            .stat-number {
                font-size: 30px;
                font-weight: bold;
                color: #ff7a00;
            }

            @@media (max-width: 768px) {

                .sidebar {
                    position: relative;
                    width: 100%;
                    min-height: auto;
                }

                .logout {
                    position: relative;
                    bottom: auto;
                    left: auto;
                    right: auto;
                    margin-top: 20px;
                }

                .main-content {
                    margin-left: 0;
                    padding: 20px;
                }

                .welcome-icon {
                    display: none;
                }
            }

    </style>
</head>

<body>

    <!-- SIDEBAR -->

    <div class="sidebar">

        <div class="logo">

            <div class="logo-icon">
                <i class="bi bi-robot"></i>
            </div>

            <h2>ChefIA</h2>

        </div>


        <a asp-controller="Home"
           asp-action="Index"
           class="menu-item active">

            <i class="bi bi-house-door-fill"></i>

            Dashboard

        </a>


        <a asp-controller="Home"
           asp-action="MisRecetas"
           class="menu-item">

            <i class="bi bi-journal-text"></i>

            Mis Recetas

        </a>

        <a asp-controller="Home"
           asp-action="Ingredientes"
           class="menu-item">

            <i class="bi bi-basket"></i>

            Ingredientes

        </a>


        <a asp-controller="Home"
           asp-action="AjusteInteligente"
           class="menu-item">

            <i class="bi bi-stars"></i>
            Ajuste Inteligente

        </a>


        <a asp-controller="Home"
           asp-action="MiPerfil"
           class="menu-item">

            <i class="bi bi-person"></i>
            Mi Perfil

        </a>


        <a asp-controller="Auth"
           asp-action="CerrarSesion"
           class="menu-item"
           onclick="return confirm('¿Estás seguro de que deseas cerrar sesión?');">

            <i class="bi bi-box-arrow-right"></i>

            Cerrar sesión

        </a>

    </div>


    <!-- CONTENIDO PRINCIPAL -->

    <div class="main-content">


        <!-- TOPBAR -->

        <div class="topbar">

            <div>

                <h4 class="mb-0">
                    Panel principal
                </h4>

                <small class="text-muted">
                    Gestiona tus recetas de manera inteligente
                </small>

            </div>


            <div class="user-info">

                <div>

                    <strong>@nombreUsuario</strong>

                    <br />

                    <small class="text-muted">
                        Usuario ChefIA
                    </small>

                </div>


                <div class="user-avatar">

                    <i class="bi bi-person-fill"></i>

                </div>

            </div>

        </div>


        <!-- BIENVENIDA -->

        <div class="welcome-card">

            <h1>
                ¡Hola, @nombreUsuario! 👋
            </h1>

            <p class="mb-0 fs-5">

                Bienvenido a ChefIA. Administra tus recetas
                y descubre una nueva forma de cocinar.

            </p>


            <div class="welcome-icon">

                <i class="bi bi-robot"></i>

            </div>

        </div>


        <!-- ESTADÍSTICAS -->

        <div class="row g-4 mb-4">

            <div class="col-md-4">

                <div class="stat-card">

                    <small class="text-muted">
                        Mis recetas
                    </small>

                    <div class="stat-number">
                        0
                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="stat-card">

                    <small class="text-muted">
                        Ingredientes registrados
                    </small>

                    <div class="stat-number">
                        0
                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="stat-card">

                    <small class="text-muted">
                        Ajustes realizados
                    </small>

                    <div class="stat-number">
                        0
                    </div>

                </div>

            </div>

        </div>


        <!-- FUNCIONES -->

        <h3 class="mb-4">
            ¿Qué deseas hacer?
        </h3>


        <div class="row g-4">


            <!-- RECETAS -->

            <div class="col-md-6 col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon">

                        <i class="bi bi-journal-text"></i>

                    </div>


                    <h4>
                        Mis Recetas
                    </h4>


                    <p>

                        Consulta y administra todas
                        tus recetas registradas.

                    </p>


                    <a asp-controller="Home"
                       asp-action="MisRecetas"
                       class="btn-feature">

                        Ver recetas

                    </a>

                </div>

            </div>


            <!-- INGREDIENTES -->

            <div class="col-md-6 col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon">

                        <i class="bi bi-basket"></i>

                    </div>


                    <h4>
                        Ingredientes
                    </h4>


                    <p>

                        Administra los ingredientes
                        disponibles en tus recetas.

                    </p>


                    <a href="#"
                       class="btn-feature">

                        Ver ingredientes

                    </a>

                </div>

            </div>


            <!-- IA -->

            <div class="col-md-6 col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon">

                        <i class="bi bi-stars"></i>

                    </div>


                    <h4>
                        Ajuste Inteligente
                    </h4>


                    <p>

                        Ajusta automáticamente las cantidades
                        según las porciones que necesitas.

                    </p>


                    <a href="#"
                       class="btn-feature">

                        Usar ChefIA

                    </a>

                </div>

            </div>


            <!-- PERFIL -->

            <div class="col-md-6 col-lg-4">

                <div class="feature-card">

                    <div class="feature-icon">

                        <i class="bi bi-person"></i>

                    </div>


                    <h4>
                        Mi Perfil
                    </h4>


                    <p>

                        Consulta y administra la información
                        de tu cuenta.

                    </p>


                    <a href="#"
                       class="btn-feature">

                        Ver perfil

                    </a>

                </div>

            </div>


        </div>

    </div>

    <!-- MODAL CERRAR SESIÓN -->

    <div class="modal fade" id="modalCerrarSesion" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:20px; border:none;">

                <div class="modal-body text-center p-4">

                    <div style="font-size:45px; color:#ff7a00;">
                        <i class="bi bi-box-arrow-right"></i>
                    </div>

                    <h4 class="fw-bold mt-3">
                        ¿Quieres cerrar sesión?
                    </h4>

                    <p class="text-muted">
                        Se cerrará tu sesión actual.
                    </p>

                    <div class="d-flex justify-content-center gap-3 mt-4">

                        <button type="button"
                                class="btn btn-secondary px-4"
                                data-bs-dismiss="modal">
                            No
                        </button>

                        <a asp-controller="Auth"
                           asp-action="CerrarSesion"
                           class="btn px-4"
                           style="background:#ff7a00; color:white;">
                            Sí
                        </a>

                    </div>

                </div>

            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>