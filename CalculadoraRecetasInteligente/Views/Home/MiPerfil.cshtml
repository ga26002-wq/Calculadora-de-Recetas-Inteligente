@model CalculadoraRecetasInteligente.Models.Usuario

@{
    ViewData["Title"] = "Mi Perfil";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>ChefIA - Mi Perfil</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            body {
                margin: 0;
                min-height: 100vh;
                font-family: Arial, sans-serif;
                background-color: #f5f6fa;
            }

            /* SIDEBAR */

            .sidebar {
                width: 260px;
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: linear-gradient(180deg, #ff7a00, #e65c00);
                color: white;
                padding: 25px 20px;
                display: flex;
                flex-direction: column;
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 45px;
            }

            .logo-icon {
                font-size: 38px;
            }

            .logo h2 {
                margin: 0;
                font-weight: bold;
            }

            .menu-item {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 14px 15px;
                margin-bottom: 8px;
                border-radius: 12px;
                color: white;
                text-decoration: none;
                transition: 0.3s;
            }

                .menu-item:hover {
                    background-color: rgba(255,255,255,0.20);
                    color: white;
                }

                .menu-item.active {
                    background-color: white;
                    color: #ff7a00;
                    font-weight: bold;
                }

            .logout {
                margin-top: auto;
            }

            /* CONTENIDO */

            .main-content {
                margin-left: 260px;
                padding: 35px;
            }

            /* TOPBAR */

            .topbar {
                background: white;
                border-radius: 18px;
                padding: 20px 25px;
                margin-bottom: 30px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            }

            /* PERFIL */

            .profile-card {
                background: white;
                border-radius: 22px;
                padding: 40px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.06);
                max-width: 900px;
            }

            .profile-header {
                display: flex;
                align-items: center;
                gap: 25px;
                margin-bottom: 35px;
            }

            .profile-icon {
                width: 90px;
                height: 90px;
                border-radius: 50%;
                background: #fff0e6;
                color: #ff7a00;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 45px;
            }

            .profile-header h2 {
                margin: 0;
                color: #2f3b4c;
                font-weight: bold;
            }

            .profile-header p {
                margin: 5px 0 0;
                color: #777;
            }

            .info-card {
                background: #fafafa;
                border-radius: 15px;
                padding: 20px;
                margin-bottom: 15px;
            }

            .info-label {
                color: #777;
                font-size: 14px;
                margin-bottom: 5px;
            }

            .info-value {
                color: #2f3b4c;
                font-size: 18px;
                font-weight: bold;
            }

            .btn-edit {
                background-color: #ff7a00;
                color: white;
                border: none;
                border-radius: 10px;
                padding: 12px 22px;
                text-decoration: none;
                font-weight: bold;
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

                .btn-edit:hover {
                    background-color: #e65c00;
                    color: white;
                }

            @@media (max-width: 768px) {

                .sidebar {
                    position: relative;
                    width: 100%;
                    height: auto;
                    min-height: auto;
                }

                .main-content {
                    margin-left: 0;
                    padding: 20px;
                }

                .profile-header {
                    flex-direction: column;
                    align-items: flex-start;
                }
            }

    </style>

</head>

<body>

    <!-- SIDEBAR -->

    <div class="sidebar">

        <div class="logo">

            <div class="logo-icon">
                <i class="bi bi-robot"></i>
            </div>

            <h2>ChefIA</h2>

        </div>


        <a asp-controller="Home"
           asp-action="Index"
           class="menu-item">

            <i class="bi bi-house-door-fill"></i>

            Dashboard

        </a>


        <a asp-controller="Home"
           asp-action="MisRecetas"
           class="menu-item">

            <i class="bi bi-journal-text"></i>

            Mis Recetas

        </a>


        <a asp-controller="Home"
           asp-action="Ingredientes"
           class="menu-item">

            <i class="bi bi-basket"></i>

            Ingredientes

        </a>


        <a asp-controller="Home"
           asp-action="AjusteInteligente"
           class="menu-item">

            <i class="bi bi-stars"></i>

            Ajuste Inteligente

        </a>


        <a asp-controller="Home"
           asp-action="MiPerfil"
           class="menu-item active">

            <i class="bi bi-person"></i>

            Mi Perfil

        </a>


        <!-- CERRAR SESIÓN -->

        <a href="#"
           class="menu-item"
           data-bs-toggle="modal"
           data-bs-target="#modalCerrarSesion">

            <i class="bi bi-box-arrow-right"></i>
            Cerrar sesión

        </a>
    </div>


    <!-- CONTENIDO -->

    <div class="main-content">

        <!-- TOPBAR -->

        <div class="topbar">

            <h3 class="mb-1">
                Mi Perfil
            </h3>

            <small class="text-muted">
                Consulta y administra tu información personal
            </small>

        </div>


        <!-- PERFIL -->

        <div class="profile-card">

            <div class="profile-header">

                <div class="profile-icon">

                    <i class="bi bi-person-fill"></i>

                </div>

                <div>

                    <h2>
                        @Model.Nombre @Model.Apellido
                    </h2>

                    <p>
                        Información de tu cuenta ChefIA
                    </p>

                </div>

            </div>


            <div class="row">

                <!-- NOMBRE -->

                <div class="col-md-6">

                    <div class="info-card">

                        <div class="info-label">
                            Nombre
                        </div>

                        <div class="info-value">
                            @Model.Nombre
                        </div>

                    </div>

                </div>


                <!-- APELLIDO -->

                <div class="col-md-6">

                    <div class="info-card">

                        <div class="info-label">
                            Apellido
                        </div>

                        <div class="info-value">
                            @Model.Apellido
                        </div>

                    </div>

                </div>


                <!-- CORREO -->

                <div class="col-md-6">

                    <div class="info-card">

                        <div class="info-label">
                            Correo electrónico
                        </div>

                        <div class="info-value">
                            @Model.Correo
                        </div>

                    </div>

                </div>


                <!-- ESTADO -->

                <div class="col-md-6">

                    <div class="info-card">

                        <div class="info-label">
                            Estado de cuenta
                        </div>

                        <div class="info-value">

                            @if (Model.Activo)
                            {
                                <span class="text-success">
                                    <i class="bi bi-check-circle-fill"></i>
                                    Activa
                                </span>
                            }
                            else
                            {
                                <span class="text-danger">
                                    <i class="bi bi-x-circle-fill"></i>
                                    Inactiva
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <!-- FECHA -->

                <div class="col-md-6">

                    <div class="info-card">

                        <div class="info-label">
                            Fecha de registro
                        </div>

                        <div class="info-value">
                            @Model.FechaRegistro.ToString("dd/MM/yyyy")
                        </div>

                    </div>

                </div>

            </div>


            <!-- BOTÓN EDITAR -->

            <div class="mt-4">

                <a asp-controller="Home"
                   asp-action="EditarPerfil"
                   class="btn-edit">

                    <i class="bi bi-pencil-square"></i>

                    Editar perfil

                </a>

            </div>

        </div>

    </div>

    <!-- MODAL CERRAR SESIÓN -->

    <div class="modal fade"
         id="cerrarSesionModal"
         tabindex="-1"
         aria-labelledby="cerrarSesionModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 rounded-4">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="cerrarSesionModalLabel">

                        <i class="bi bi-box-arrow-right me-2"></i>
                        Cerrar sesión

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body text-center p-4">

                    <div style="font-size: 55px; color: #ff7a00;">

                        <i class="bi bi-question-circle"></i>

                    </div>

                    <h4 class="mt-3">
                        ¿Deseas cerrar sesión?
                    </h4>

                    <p class="text-muted">

                        Tendrás que iniciar sesión nuevamente para continuar.

                    </p>

                </div>


                <div class="modal-footer border-0 justify-content-center">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>


                    <a asp-controller="Auth"
                       asp-action="CerrarSesion"
                       class="btn btn-danger">

                        <i class="bi bi-box-arrow-right"></i>

                        Sí, cerrar sesión

                    </a>

                </div>

            </div>

        </div>

    </div>

    <!-- MODAL CERRAR SESIÓN -->
    <div class="modal fade" id="modalCerrarSesion" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:20px; border:none;">

                <div class="modal-body text-center p-4">

                    <div style="font-size:45px; color:#ff7a00;">
                        <i class="bi bi-box-arrow-right"></i>
                    </div>

                    <h4 class="fw-bold mt-3">
                        ¿Quieres cerrar sesión?
                    </h4>

                    <p class="text-muted">
                        Se cerrará tu sesión actual.
                    </p>

                    <div class="d-flex justify-content-center gap-3 mt-4">

                        <button type="button"
                                class="btn btn-secondary px-4"
                                data-bs-dismiss="modal">
                            No
                        </button>

                        <a asp-controller="Auth"
                           asp-action="CerrarSesion"
                           class="btn px-4"
                           style="background:#ff7a00; color:white;">
                            Sí
                        </a>

                    </div>

                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>